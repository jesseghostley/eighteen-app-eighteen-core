# Eighteen Core — Environment Variables
# Copy this file: cp .env.example .env
# Then fill in your values below.

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=

# Anthropic API Key (from console.anthropic.com)
ANTHROPIC_API_KEY=

# GitHub Personal Access Token (fine-grained, scoped to your repo)
GITHUB_PAT=

# Pope-Claw webhook secret (generate with: openssl rand -hex 32)
POPE_CLAW_WEBHOOK_SECRET=

# GitHub repo for Pope-Claw execution (owner/repo)
POPE_CLAW_REPO=jesseghostley/eighteen-app-eighteen-core

# Webhook callback URL (your host must be reachable from GitHub)
# Options: Tailscale, Cloudflare Tunnel, or public IP
POPE_CLAW_CALLBACK_URL=https://your-host/api/pope-claw/callback

# Claude model (optional, defaults to claude-sonnet-4-20250514)
# EIGHTEEN_MODEL=claude-sonnet-4-20250514

# Gateway port (optional, defaults to 3000)
# EIGHTEEN_PORT=3000
