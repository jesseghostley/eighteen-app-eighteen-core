# Eighteen Core — Environment Variables
# Copy this file: cp .env.example .env
# Then fill in your values below.

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=

# GitHub Personal Access Token (fine-grained, scoped to your repo)
GITHUB_PAT=

# Pope-Claw webhook secret (generate with: openssl rand -hex 32)
POPE_CLAW_WEBHOOK_SECRET=

# GitHub repo for Pope-Claw execution (owner/repo)
POPE_CLAW_REPO=jesseghostley/eighteen-app-eighteen-core

# Webhook callback URL (your host must be reachable from GitHub)
# Options: Tailscale, Cloudflare Tunnel, or public IP
POPE_CLAW_CALLBACK_URL=https://your-host/api/pope-claw/callback

# --- LLM Provider Configuration ---
# Provider: "anthropic" (direct Claude SDK) or "openrouter" (any model)
# EIGHTEEN_PROVIDER=anthropic

# API key for your chosen provider (set ONE):
ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=

# Model to use (provider-specific format):
#   Anthropic:  claude-sonnet-4-20250514
#   OpenRouter: anthropic/claude-sonnet-4-20250514
#               openai/gpt-5
#               google/gemini-2.0-pro
#               qwen/qwen3-coder-480b-a35b-instruct
#               qwen/qwen3.5-397b-a17b
#               qwen/qwen3-max-thinking
# EIGHTEEN_MODEL=claude-sonnet-4-20250514

# --- Web Search ---
# Brave Search API key (get one at https://brave.com/search/api/)
# BRAVE_SEARCH_API_KEY=

# Gateway port (optional, defaults to 3000)
# EIGHTEEN_PORT=3000
